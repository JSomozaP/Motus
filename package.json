{
  "name": "motus",
  "version": "1.0.0",
  "description": "Jeu Motus - Application Full Stack",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd client && ng serve --port 4201",
    "dev": "nodemon server/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "clean": "pkill -f \"ng serve\" || true && pkill -f \"node index.js\" || true"
  },
  "keywords": ["motus", "jeu", "full-stack"],
  "author": "Jeremy",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.10"
  }
}